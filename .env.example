# ============================================================
# .env.example — copy to .env.local for dev; set the same keys
# in Vercel Project Settings for production. NEVER commit real
# values. NEVER expose SERVICE_ROLE or PayHere secret client-side.
# ============================================================

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000          # prod: https://yourshop.lk
NEXT_PUBLIC_DEFAULT_LOCALE=en                       # en | si | ta

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                      # safe in browser ONLY because RLS is on
SUPABASE_SERVICE_ROLE_KEY=                          # SERVER ONLY (webhooks, checkout, cron)

# ---------- POS integration (TZL POS backend = source of truth) ----------
# When NEXT_PUBLIC_POS_API_URL is set, the storefront reads catalog/stock from
# the POS API instead of Supabase (see lib/pos/*). Leave blank to stay on
# Supabase/demo. The website's origin MUST be added to the POS backend's CORS
# allowedOrigins list (tzl-pos-be-v2 src/app.js) for browser calls to work.
NEXT_PUBLIC_POS_API_URL=                            # e.g. https://api.tzl-pos.example  (no /api suffix)
NEXT_PUBLIC_POS_IMAGE_URL=                          # base host for POS product images (defaults to API URL)

# ---------- PayHere ----------
PAYHERE_MODE=sandbox                                # sandbox | live
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=                            # SERVER ONLY — used for md5sig verify
# Webhook URL to register in PayHere dashboard:
#   {NEXT_PUBLIC_SITE_URL}/api/payhere/notify

# ---------- Koko (BNPL) ----------
# KOKO_MODE picks which of Koko's environments orders actually go to.
# It defaults to 'dev' (their own "developer preview" API) if left unset or
# set to anything other than exactly 'live' or 'qa' — so for a REAL storefront
# taking real customer payments, KOKO_MODE MUST be explicitly set to 'live'.
# Leaving this unset in production silently sends real customers to Koko's
# dev/QA environment instead of their production one (which, among other
# things, is not guaranteed to be mobile-responsive the way their live
# checkout page is).
KOKO_MODE=dev                                       # dev | qa | live — MUST be 'live' in production
KOKO_MERCHANT_ID=
KOKO_API_KEY=                                       # SERVER ONLY
KOKO_PRIVATE_KEY=                                   # SERVER ONLY — your merchant signing key (PEM)
KOKO_PUBLIC_KEY=                                    # SERVER ONLY — Koko's public key, verifies their webhook/orderView responses
KOKO_PLUGIN_VERSION=1                               # as assigned by Koko; defaults to '1' if unset
# Response webhook URL to register with Koko's merchant success team:
#   {NEXT_PUBLIC_SITE_URL}/api/koko/response

# ---------- WhatsApp ----------
NEXT_PUBLIC_WHATSAPP_NUMBER=94XXXXXXXXX             # shop number for wa.me links
# Future (behind feature flag whatsapp_cloud_api):
# WHATSAPP_CLOUD_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# ---------- Web Push (PWA) ----------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                                  # SERVER ONLY
VAPID_SUBJECT=mailto:owner@yourshop.lk

# ---------- Rate limiting (Upstash Redis, free tier OK) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Cron (Vercel Cron -> /api/cron/release-reservations) ----------
CRON_SECRET=                                        # random string; cron route checks it
